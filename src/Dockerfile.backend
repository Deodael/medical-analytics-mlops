# Use a rock-solid, official slim Python runtime
FROM python:3.11-slim

# Set the working directory inside the container
WORKDIR /app

# Copy the top-level requirements file into the container
COPY requirements.txt .

# Install the Python dependencies cleanly without caching build files
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire contents of the src directory into the container's working directory
COPY src/ .

# Expose port 8000, which is the default port for your FastAPI app
EXPOSE 8000

# Run Uvicorn to boot up your main.py FastAPI app on container startup
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
